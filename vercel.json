{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "fitcheck/backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/chat", "destination": "/api/index.py" },
    { "source": "/products", "destination": "/api/index.py" },
    { "source": "/products/(.*)", "destination": "/api/index.py" },
    { "source": "/stores", "destination": "/api/index.py" },
    { "source": "/session/(.*)", "destination": "/api/index.py" }
  ]
}
