# ==========================================
# FitCheck Backend — Environment Variables
# ==========================================

# Server Port (assigned dynamically by Render in production)
PORT=8000

# Allowed Frontend Origins for CORS (comma-separated, no trailing slashes)
# In production, add your Vercel deployment URL: e.g. https://fitcheck.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Optional: Google Gemini API Key for LLM natural-language paraphrasing & intent extraction
# If omitted or invalid, FitCheck runs 100% deterministically using the built-in MockLLM
GEMINI_API_KEY=your_gemini_api_key_here

