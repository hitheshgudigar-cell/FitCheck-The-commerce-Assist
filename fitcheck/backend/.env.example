# ==========================================
# FitCheck Backend — Environment Variables (Vercel)
# ==========================================

# Optional: Google Gemini API Key for LLM natural-language paraphrasing & intent extraction
# In Vercel, add this under Settings -> Environment Variables.
# If omitted or invalid, FitCheck runs 100% deterministically using the built-in MockLLM.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Allowed Frontend Origins for CORS
# In unified Vercel deployment, the API and frontend share the same origin, so CORS is not required.
# For local development or cross-origin previews:
ALLOWED_ORIGINS=http://localhost:5173
