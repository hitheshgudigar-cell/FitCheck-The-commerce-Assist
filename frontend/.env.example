# ==========================================
# FitCheck Frontend — Environment Variables
# ==========================================

# When deploying on Vercel (unified single-domain deployment):
# Leave VITE_API_URL unset or set to empty string. The frontend automatically routes API calls to the same origin (/chat, /products, etc.).
VITE_API_URL=

# For local development with standalone FastAPI server:
# VITE_API_URL=http://localhost:8000
